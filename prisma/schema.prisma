// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgres"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Landlord – main logged-in application user (NextAuth + app fields)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null for OAuth-only users
  firstName     String?
  lastName      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  properties Property[]

  @@map("users")
}

// NextAuth: OAuth/Provider account linked to User (user created in DB if not exists)
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth: Session stored in DB
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Real-estate property – belongs to one User, has many Tenants
model Property {
  id        String   @id @default(cuid())
  name      String   // unique per landlord
  address   String
  city      String
  state     String
  zip       String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  landlordId String
  landlord   User     @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  tenants    Tenant[]

  @@unique([landlordId, name])
  @@map("properties")
}

// Tenant – lives at one Property; rentAmount added to amountOwed on the 1st of each month
model Tenant {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  rentAmount  Decimal  @db.Decimal(10, 2)  // added to amountOwed on 1st of month
  amountOwed  Decimal  @default(0) @db.Decimal(10, 2)  // updated when payments are submitted
  unit        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@map("tenants")
}

// Record of a payment – subtracting from Tenant.amountOwed
model Payment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payments")
}
