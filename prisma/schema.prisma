// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgres"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Landlord – main logged-in application user
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@map("users")
}

// Real-estate property – belongs to one User, has many Tenants
model Property {
  id        String   @id @default(cuid())
  name      String   // unique per landlord
  address   String
  city      String
  state     String
  zip       String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  landlordId String
  landlord   User     @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  tenants    Tenant[]

  @@unique([landlordId, name])
  @@map("properties")
}

// Tenant – lives at one Property; rentAmount added to amountOwed on the 1st of each month
model Tenant {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  rentAmount  Decimal  @db.Decimal(10, 2)  // added to amountOwed on 1st of month
  amountOwed  Decimal  @default(0) @db.Decimal(10, 2)  // updated when payments are submitted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@map("tenants")
}

// Record of a payment – subtracting from Tenant.amountOwed
model Payment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payments")
}
